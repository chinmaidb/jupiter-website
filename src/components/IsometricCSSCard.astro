---
interface Props {
  title?: string;
  description?: string;
  metric?: string;
}

const { title = "3D System", description = "Interactive geometry layer", metric = "01" } = Astro.props as Props;
---

<div class="group relative h-56 w-full perspective-[1200px]" aria-label="Pseudo-isometric card">
  <div class="relative h-full w-full transition-transform duration-300 ease-out group-hover:-translate-y-2 group-hover:translate-x-1" style="transform-style: preserve-3d; transform: rotateX(58deg) rotateZ(-38deg);">
    <div class="absolute inset-x-3 top-3 h-10 border border-zinc-600 bg-[#0b1020]" style="clip-path: polygon(0 0, 100% 0, calc(100% - 12px) 100%, 0 100%);"></div>
    <div class="absolute inset-x-3 bottom-0 h-36 border border-zinc-700 bg-[#101827] shadow-[8px_8px_0px_0px_rgba(37,99,235,1)]" style="clip-path: polygon(0 12%, 100% 12%, 100% 100%, 0 100%);"></div>
    <div class="absolute inset-x-8 top-12 h-10 border border-[#a3e635] bg-[#111827] px-2 text-[0.55rem] font-mono uppercase tracking-[0.25em] text-[#d9f99d] flex items-center justify-between">
      <span>{metric}</span>
      <span>SYS</span>
    </div>
    <div class="absolute inset-x-12 bottom-10 text-left">
      <p class="font-mono text-[0.58rem] uppercase tracking-[0.26em] text-zinc-400">{title}</p>
      <p class="mt-3 max-w-[12rem] text-sm text-zinc-200">{description}</p>
    </div>
  </div>
</div>
