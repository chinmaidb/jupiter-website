---
import GeometricGridBackground from "./GeometricGridBackground.astro";
import IsometricCanvas from "./IsometricCanvas.astro";
import IsometricCSSCard from "./IsometricCSSCard.astro";
---

<div data-hero-grid class="geo-panel relative overflow-hidden">
  <GeometricGridBackground />

  <div class="relative border-b border-zinc-800 bg-[#0b1020]/80 px-4 py-3">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <span class="font-mono text-[0.6rem] uppercase tracking-[0.26em] text-zinc-300">// [01/3D-GRID]</span>
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" data-control="rotate" class="border border-zinc-700 bg-[#111827] px-2 py-1 font-mono text-[0.52rem] uppercase tracking-[0.2em] text-zinc-100">Rotate</button>
        <button type="button" data-control="grid" class="border border-zinc-700 bg-[#111827] px-2 py-1 font-mono text-[0.52rem] uppercase tracking-[0.2em] text-zinc-100">Grid Span</button>
        <button type="button" data-control="wireframe" class="border border-zinc-700 bg-[#111827] px-2 py-1 font-mono text-[0.52rem] uppercase tracking-[0.2em] text-zinc-100">Wireframe</button>
      </div>
    </div>
  </div>

  <div class="relative grid gap-0 lg:grid-cols-[1.45fr_0.55fr]">
    <div class="border-r border-zinc-800 p-4 md:p-6">
      <IsometricCanvas />
    </div>

    <aside class="space-y-4 border-t border-zinc-800 bg-[#0b1020]/80 p-4 md:p-6 lg:border-t-0">
      <div class="flex items-center justify-between border-b border-zinc-800 pb-3">
        <span class="font-mono text-[0.58rem] uppercase tracking-[0.2em] text-zinc-400">coord</span>
        <span class="font-mono text-[0.58rem] uppercase tracking-[0.2em] text-[#a3e635]">x-104</span>
      </div>

      <div class="space-y-4">
        <h3 class="font-display text-2xl text-white">Volume map</h3>
        <p class="text-sm leading-6 text-zinc-300">A modular, orthographic structure that balances motion, clarity, and precise spatial rhythm.</p>
      </div>

      <div class="border border-zinc-700 bg-[#070b11] p-3">
        <p class="font-mono text-[0.56rem] uppercase tracking-[0.25em] text-zinc-400">Layer stack</p>
        <div class="mt-3 space-y-2">
          <div class="flex items-center justify-between border-b border-zinc-800 pb-2 text-sm text-zinc-200"><span>Grid</span><span class="text-[#a3e635]">01</span></div>
          <div class="flex items-center justify-between border-b border-zinc-800 pb-2 text-sm text-zinc-200"><span>HUD</span><span class="text-[#a3e635]">02</span></div>
          <div class="flex items-center justify-between text-sm text-zinc-200"><span>Volume</span><span class="text-[#a3e635]">03</span></div>
        </div>
      </div>

      <IsometricCSSCard title="Module 01" description="Structured, layered, and ready for motion." metric="01" />
    </aside>
  </div>
</div>

<script type="module">
  (() => {
    const root = document.currentScript?.previousElementSibling;
    if (!root) return;

    const buttons = root.querySelectorAll("[data-control]");
    const canvas = root.querySelector("[data-isometric-canvas]");

    for (const button of buttons) {
      button.addEventListener("click", () => {
        const control = button.dataset.control;
        const isActive = button.classList.toggle("is-active");
        button.style.borderColor = isActive ? "rgba(163, 230, 53, 0.9)" : "rgba(82, 88, 99, 1)";
        button.style.color = isActive ? "#a3e635" : "#f4f4f5";

        if (control === "grid" && canvas) {
          canvas.style.backgroundSize = isActive ? "100% 100%" : "auto";
        }

        if (control === "wireframe" && canvas) {
          canvas.dataset.wireframe = String(isActive);
        }

        if (control === "rotate" && canvas) {
          canvas.dataset.rotate = String(isActive);
        }
      });
    }
  })();
</script>
