---
import GeometricCard from "./GeometricCard.astro";
import GeometricGridBackground from "./GeometricGridBackground.astro";
import IsometricCanvas from "./IsometricCanvas.astro";
---

<section class="relative overflow-hidden border-y border-zinc-800 bg-[#090A0F]">
  <GeometricGridBackground />

  <div class="section-inner relative grid gap-8 py-12 md:py-20 xl:grid-cols-[1.1fr_0.9fr] xl:items-center">
    <div class="space-y-6">
      <span class="geo-chip">// 01. intro</span>
      <h1 class="max-w-xl font-display text-4xl leading-[0.95] tracking-[-0.06em] text-white md:text-6xl xl:text-7xl">
        Build <span class="text-[#a3e635]">measurable</span> digital experiences.
      </h1>
      <p class="max-w-xl text-base leading-7 text-zinc-300 md:text-lg">
        I design and build conversion-focused websites, product experiences, and scalable web apps that help teams ship faster and grow with clarity.
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <a href="/contact" class="geo-button">Start a project</a>
        <a href="/portfolio" class="geo-button secondary">View portfolio</a>
      </div>

      <div class="grid gap-3 pt-2 sm:grid-cols-3">
        <GeometricCard
          eyebrow="UX"
          title="Systems"
          description="Clear product logic with human-centered interfaces."
          meta="X-104"
          accent="blue"
        />
        <GeometricCard
          eyebrow="BUILD"
          title="Code"
          description="Robust engineering and clean implementation."
          meta="V-16"
          accent="lime"
        />
        <GeometricCard
          eyebrow="GROW"
          title="Results"
          description="Web experiences tuned for trust and conversion."
          meta="Q-7"
          accent="neutral"
        />
      </div>
    </div>

    <div class="relative">
      <IsometricCanvas />
      <div class="absolute -bottom-5 left-5 max-w-[16rem] border border-zinc-700 bg-[#0b1020]/90 p-3 shadow-[6px_6px_0px_0px_rgba(37,99,235,1)]">
        <p class="font-mono text-[0.58rem] uppercase tracking-[0.24em] text-zinc-400">workflow</p>
        <div class="mt-3 space-y-2 text-sm text-zinc-200">
          <div class="flex items-center justify-between gap-4 border-b border-zinc-700 pb-2">
            <span>Strategy</span>
            <span class="text-[#a3e635]">01</span>
          </div>
          <div class="flex items-center justify-between gap-4 border-b border-zinc-700 pb-2">
            <span>Design</span>
            <span class="text-[#a3e635]">02</span>
          </div>
          <div class="flex items-center justify-between gap-4">
            <span>Build</span>
            <span class="text-[#a3e635]">03</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
