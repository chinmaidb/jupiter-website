---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  meta?: string;
  class?: string;
  accent?: "blue" | "lime" | "neutral";
}

const {
  eyebrow = "COORD",
  title,
  description = "",
  meta = "",
  accent = "blue",
  class: className = "",
} = Astro.props as Props;

const accentClasses = {
  blue: "border-[#2563eb] text-[#93c5fd]",
  lime: "border-[#a3e635] text-[#d9f99d]",
  neutral: "border-zinc-700 text-zinc-200",
};
---

<article class:list={["geo-card group", className]}>
  <div class="mb-4 flex items-center justify-between gap-3">
    <span class="geo-chip">{eyebrow}</span>
    <span class:list={["inline-flex h-2.5 w-2.5 border border-zinc-700 bg-transparent shadow-[0_0_0_4px_rgba(37,99,235,0.18)]", accentClasses[accent]]}></span>
  </div>
  <h3 class="font-display text-xl font-medium text-white md:text-2xl">{title}</h3>
  {description && <p class="mt-3 text-sm leading-6 text-zinc-300">{description}</p>}
  {meta && <div class="mt-5 border border-zinc-700 bg-[#090A0F] px-3 py-2 font-mono text-[0.62rem] uppercase tracking-[0.2em] text-zinc-200">{meta}</div>}
</article>
