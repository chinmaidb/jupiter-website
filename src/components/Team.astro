---
const team = [
  {
    name: "Girish KV",
    role: "Founder",
    bio: "Obsessed with clean code and retro aesthetics.",
    image: "https://i.pravatar.cc/300?u=Girish",
    linkedin: "https://www.linkedin.com/in/girisha-kv-b30b6719/"
  },
  {
    name: "Chinmai D",
    role: "Co-Founder and CTO",
    bio: "Crafting interfaces that feel as good as they look.",
    image: "https://i.pravatar.cc/300?u=chinmai.bharadwaj@ymail.com",
    linkedin: "https://www.linkedin.com/in/chinmaidbharadwaj/",
    github: "https://github.com/chinmaidb"
  },
];
---

<section id="team" class="section-block section-with-bg section-muted">
  <div class="section-inner">
    <div class="text-center mb-16 reveal-section">
      <h2 class="text-4xl font-bold mb-4">Meet the Crew</h2>
      <p class="text-lg opacity-80 max-w-2xl mx-auto">
        A small team of humans (and a few robots) working together to build 
        something cosmic.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {team.map((member) => (
        <div class="card bg-base-100 shadow-xl border border-base-300 reveal-item">
          <figure class="px-6 pt-8">
            <div class="avatar">
              <div class="w-32 rounded-full ring-primary ring-offset-base-100 ring ring-offset-2">
                <img src={member.image} alt={member.name} />
              </div>
            </div>
          </figure>
          <div class="card-body items-center text-center">
            <h3 class="card-title text-2xl">{member.name}</h3>
            <div class="badge badge-primary badge-outline">{member.role}</div>
            <p class="mt-4 text-sm opacity-70">
              {member.bio}
            </p>
            <div class="card-actions mt-4">
              {member.linkedin && (
                <a href={member.linkedin} target="_blank" class="btn btn-ghost btn-sm btn-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
              </a>
              )}
              {member.github && (
                <a href={member.github} target="_blank" class="btn btn-ghost btn-sm btn-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.026 2.747-1.026.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017c0-5.533-4.48-10.01-10-10z" clip-rule="evenodd" />
                </svg>
              </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
