---
const testimonials = [
  {
    quote: "Sirius transformed our digital presence. Their attention to detail and retro aesthetic gave us a unique edge in the market.",
    author: "Elena Rodriguez",
    role: "CEO, RetroTech",
    // Using a placeholder. In production, replace with local images or optimized assets
    avatar: "https://ui-avatars.com/api/?name=Elena+Rodriguez&background=random" 
  },
  {
    quote: "The team is incredibly talented. They delivered our project on time and exceeded our expectations with the functionality.",
    author: "Marcus Chen",
    role: "CTO, FutureFlow",
    avatar: "https://ui-avatars.com/api/?name=Marcus+Chen&background=random"
  },
  {
    quote: "Working with them was a breeze. Professional, creative, and technically sound. Highly recommended for any web development needs.",
    author: "Sarah Jenkins",
    role: "Marketing Director, BrightSide",
    avatar: "https://ui-avatars.com/api/?name=Sarah+Jenkins&background=random"
  }
];
---

<section id="testimonials" class="section-block section-with-bg section-muted reveal-section">
  <div class="section-inner">
    <div class="text-center max-w-3xl mx-auto mb-16 reveal-item">
      <h2 class="text-4xl font-bold mb-6 text-primary">Trusted by Partners</h2>
      <p class="text-lg opacity-80">
        We build lasting relationships with our clients. Here is what they have to say about working with us.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((t, index) => (
        <div 
          class="card bg-base-100 shadow-xl border border-base-200 reveal-item h-full" 
          style={`transition-delay: ${index * 100}ms`}
        >
          <div class="card-body">
            <div class="flex items-center gap-4 mb-4">
              <div class="avatar">
                <div class="w-12 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2">
                  <img src={t.avatar} alt={t.author} loading="lazy" />
                </div>
              </div>
              <div>
                <h3 class="font-bold">{t.author}</h3>
                <p class="text-xs opacity-70 uppercase tracking-wide">{t.role}</p>
              </div>
            </div>
            <p class="italic opacity-90 mb-4">"{t.quote}"</p>
            <div class="card-actions justify-end mt-auto">
              <div class="rating rating-sm">
                <input type="radio" name={`rating-${index}`} class="mask mask-star-2 bg-orange-400" disabled />
                <input type="radio" name={`rating-${index}`} class="mask mask-star-2 bg-orange-400" disabled />
                <input type="radio" name={`rating-${index}`} class="mask mask-star-2 bg-orange-400" disabled />
                <input type="radio" name={`rating-${index}`} class="mask mask-star-2 bg-orange-400" disabled />
                <input type="radio" name={`rating-${index}`} class="mask mask-star-2 bg-orange-400" checked disabled />
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>