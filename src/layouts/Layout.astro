---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  schemaType?: "Organization" | "WebPage" | "Article";
}

const {
  title = "Shreshta SMG | Full-Stack Product Development",
  description =
    "Shreshta SMG builds high-performing websites and scalable web applications for startups and growth-stage teams.",
  canonicalPath = "/",
  schemaType = "WebPage",
} = Astro.props as Props;

const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const ogImage = new URL("/og-image.png", Astro.site).toString();
---

<!doctype html>
<html lang="en" data-theme="retro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Shreshta SMG" />
    <meta
      name="keywords"
      content="full-stack development, web application development, UI UX implementation, API backend development, Astro development, React development"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f1665d" />

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap"
    />

    <script type="application/ld+json">
      {JSON.stringify(
        schemaType === "Organization"
          ? {
              "@context": "https://schema.org",
              "@type": "Organization",
              name: "Shreshta SMG",
              url: "https://shreshtasmg.in",
              email: "shreshtasmg@gmail.com",
              telephone: "+91-9110821035",
              sameAs: [
                "https://www.linkedin.com/in/girisha-kv-b30b6719/",
                "https://www.linkedin.com/in/chinmaidbharadwaj/",
              ],
              description,
            }
          : {
              "@context": "https://schema.org",
              "@type": schemaType,
              name: title,
              url: canonicalUrl,
              description,
            },
      )}
    </script>

    <script
      is:inline
      src={`https://www.google.com/recaptcha/api.js?render=${import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY}`}
      async
      defer></script>
  </head>
  <body
    class="min-h-screen font-body bg-base-100 text-base-content overflow-x-hidden flex flex-col"
  >
    <canvas id="painted-bg" class="painted-bg" aria-hidden="true"></canvas>
    <main class="relative flex-1">
      <slot />
    </main>
  </body>
</html>
