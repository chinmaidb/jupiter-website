---
import Footer from "../components/Footer.astro";
import HeroSection from "../components/HeroSection.astro";
import IsometricHeroGrid from "../components/IsometricHeroGrid.astro";
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Shreshta SMG | Full-Stack Product Development"
  description="We build conversion-focused websites and scalable web applications for startups and growth-stage teams."
  canonicalPath="/"
  schemaType="Organization"
>
  <Navbar />
  <HeroSection />

  <section class="section-block px-4">
    <div class="section-inner space-y-6">
      <div class="space-y-3">
        <span class="geo-chip">// 02. capability</span>
        <h2 class="max-w-3xl font-display text-3xl text-white md:text-5xl">Built for measurable outcomes, not superficial polish.</h2>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        <article class="geo-card">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-zinc-400">service scope</p>
          <h3 class="mt-4 text-2xl font-medium text-white">Websites, apps, APIs</h3>
          <p class="mt-3 text-sm leading-6 text-zinc-300">Strategy, product thinking, and frontend/backend implementation in one accountable workflow.</p>
        </article>
        <article class="geo-card">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-zinc-400">engagement</p>
          <h3 class="mt-4 text-2xl font-medium text-white">Project + retainers</h3>
          <p class="mt-3 text-sm leading-6 text-zinc-300">Flexible support for launches, product iteration, and steady engineering momentum.</p>
        </article>
        <article class="geo-card">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-zinc-400">response</p>
          <h3 class="mt-4 text-2xl font-medium text-white">Fast, clear, direct</h3>
          <p class="mt-3 text-sm leading-6 text-zinc-300">You get concise communication, realistic delivery plans, and a product-first approach.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-block px-4">
    <div class="section-inner">
      <IsometricHeroGrid />
    </div>
  </section>

  <section class="section-block px-4 pt-0">
    <div class="section-inner grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div class="space-y-5">
        <span class="geo-chip">// 03. proof</span>
        <h2 class="font-display text-3xl text-white md:text-5xl">Work that blends clarity, polish, and engineering depth.</h2>
        <p class="max-w-xl text-base leading-7 text-zinc-300">From launch-ready marketing sites to full-stack product platforms, I focus on the details that improve trust, conversion, and runtime performance.</p>
        <a href="/portfolio" class="geo-button">Explore portfolio</a>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <article class="geo-card">
          <p class="font-mono text-[0.62rem] uppercase tracking-[0.24em] text-zinc-400">SaaS</p>
          <h3 class="mt-4 text-xl text-white">Customer products</h3>
          <p class="mt-3 text-sm leading-6 text-zinc-300">Scalable architecture, polished UX, and resilient implementation patterns.</p>
        </article>
        <article class="geo-card">
          <p class="font-mono text-[0.62rem] uppercase tracking-[0.24em] text-zinc-400">marketing</p>
          <h3 class="mt-4 text-xl text-white">Conversion systems</h3>
          <p class="mt-3 text-sm leading-6 text-zinc-300">Clear positioning, efficient content structure, and measurable funnel performance.</p>
        </article>
        <article class="geo-card">
          <p class="font-mono text-[0.62rem] uppercase tracking-[0.24em] text-zinc-400">internal tools</p>
          <h3 class="mt-4 text-xl text-white">Operations velocity</h3>
          <p class="mt-3 text-sm leading-6 text-zinc-300">Productivity and workflow systems built to reduce friction and boost accuracy.</p>
        </article>
        <article class="geo-card">
          <p class="font-mono text-[0.62rem] uppercase tracking-[0.24em] text-zinc-400">optimization</p>
          <h3 class="mt-4 text-xl text-white">Refactoring impact</h3>
          <p class="mt-3 text-sm leading-6 text-zinc-300">Performance wins, cleaner code, and a maintainable structure for the long term.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-block px-4">
    <div class="section-inner text-center">
      <div class="geo-panel px-6 py-8 md:px-12 md:py-14">
        <span class="geo-chip">// 04. next step</span>
        <h2 class="mt-6 font-display text-3xl text-white md:text-5xl">Ready to modernize your digital presence?</h2>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-zinc-300">Tell us about your goals, timeline, and scope. I’ll map a pragmatic plan to move you forward with confidence.</p>
        <div class="mt-8 flex justify-center">
          <a href="/contact" class="geo-button">Start your project</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
