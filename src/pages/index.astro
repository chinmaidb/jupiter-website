---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Shreshta SMG | Full-Stack Product Development"
  description="We build conversion-focused websites and scalable web applications for startups and growth-stage teams."
  canonicalPath="/"
  schemaType="Organization"
>
  <Navbar />

  <section id="chapter-1" class="section-block px-4 story-chapter" data-chapter-color="oklch(96% 0.02 245)">
    <div class="section-inner grid gap-8 md:grid-cols-2 md:items-center">
      <div class="space-y-5 cinematic-item">
        <span class="badge badge-outline border-dashed text-xs uppercase tracking-[0.2em]">Chapter 1 · Positioning</span>
        <h1 class="font-display text-4xl leading-tight md:text-5xl">Web experiences that build trust and generate qualified leads</h1>
        <p class="max-w-xl text-base md:text-lg">We combine UX strategy, conversion-focused copy, and scalable engineering to help businesses launch faster and grow with confidence.</p>
        <div class="flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-primary btn-lg normal-case">Book a discovery call</a>
          <a href="/portfolio" class="btn btn-ghost btn-lg normal-case">View case studies</a>
        </div>
      </div>
      <div class="card bg-base-100/90 border border-base-300 shadow-xl cinematic-item">
        <div class="card-body">
          <h2 class="card-title">What you get</h2>
          <ul class="space-y-2 text-sm">
            <li>Clear service positioning and messaging</li>
            <li>Improved mobile UX and technical performance</li>
            <li>SEO-ready site structure and schema</li>
            <li>Scalable, maintainable implementation</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="chapter-2" class="section-block px-4 pt-0 story-chapter" data-chapter-color="oklch(93% 0.03 230)">
    <div class="section-inner space-y-6">
      <div class="cinematic-item">
        <span class="badge badge-outline text-xs uppercase tracking-[0.2em]">Chapter 2 · Capability</span>
        <h2 class="font-display text-3xl md:text-4xl">Built for business outcomes, not vanity features</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-box border border-base-300 bg-base-100 p-4 cinematic-item"><p class="text-xs uppercase tracking-wider text-base-content/60">Service scope</p><p class="mt-2 font-semibold">Websites, web apps, APIs</p></div>
        <div class="rounded-box border border-base-300 bg-base-100 p-4 cinematic-item"><p class="text-xs uppercase tracking-wider text-base-content/60">Engagement</p><p class="mt-2 font-semibold">Project-based and retainer</p></div>
        <div class="rounded-box border border-base-300 bg-base-100 p-4 cinematic-item"><p class="text-xs uppercase tracking-wider text-base-content/60">Response time</p><p class="mt-2 font-semibold">Within 24 hours</p></div>
      </div>
    </div>
  </section>

  <section id="chapter-3" class="section-block px-4 story-chapter" data-chapter-color="oklch(90% 0.04 210)">
    <div class="section-inner grid gap-6 md:grid-cols-2 md:items-center">
      <div class="cinematic-item space-y-4">
        <span class="badge badge-outline text-xs uppercase tracking-[0.2em]">Chapter 3 · Proof</span>
        <h2 class="font-display text-3xl md:text-4xl">Work that balances design clarity and engineering depth</h2>
        <p class="max-w-xl">Explore projects where we improved usability, performance, and conversion through focused product execution.</p>
        <a href="/portfolio" class="btn btn-primary normal-case">Explore portfolio</a>
      </div>
      <div class="grid gap-4 cinematic-item">
        <div class="rounded-box border border-base-300 bg-base-100 p-4"><p class="text-sm font-semibold">SaaS Platforms</p><p class="text-sm text-base-content/70 mt-1">Scalable architecture and fast interfaces.</p></div>
        <div class="rounded-box border border-base-300 bg-base-100 p-4"><p class="text-sm font-semibold">Marketing Websites</p><p class="text-sm text-base-content/70 mt-1">Conversion-first information architecture.</p></div>
        <div class="rounded-box border border-base-300 bg-base-100 p-4"><p class="text-sm font-semibold">Internal Tools</p><p class="text-sm text-base-content/70 mt-1">Operational efficiency with secure workflows.</p></div>
      </div>
    </div>
  </section>

  <section id="chapter-4" class="section-block px-4 story-chapter" data-chapter-color="oklch(88% 0.05 190)">
    <div class="section-inner text-center space-y-6 cinematic-item">
      <span class="badge badge-outline text-xs uppercase tracking-[0.2em]">Chapter 4 · Next Step</span>
      <h2 class="font-display text-3xl md:text-4xl">Ready to modernize your website and improve conversions?</h2>
      <p class="mx-auto max-w-2xl">Tell us about your goals, timeline, and scope. We will respond with a clear action plan within 24 hours.</p>
      <a href="/contact" class="btn btn-primary btn-lg normal-case">Start your project</a>
    </div>
  </section>

  <Footer />

  <script>
    if (typeof window !== "undefined" && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      Promise.all([
        import("gsap"),
        import("gsap/ScrollTrigger"),
        import("three"),
        import("lenis"),
      ]).then(([gsapModule, triggerModule, THREE, lenisModule]) => {
        const gsap = gsapModule.gsap;
        const ScrollTrigger = triggerModule.ScrollTrigger;
        const Lenis = lenisModule.default;
        gsap.registerPlugin(ScrollTrigger);

        const lenis = new Lenis({ smoothWheel: true, lerp: 0.08 });
        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);
        lenis.on("scroll", ScrollTrigger.update);

        const sections = document.querySelectorAll(".story-chapter");
        sections.forEach((section) => {
          const items = section.querySelectorAll(".cinematic-item, h1, h2, p, .btn, .badge");

          gsap.fromTo(section,
            { opacity: 0.35, y: 56, filter: "blur(5px)" },
            {
              opacity: 1,
              y: 0,
              filter: "blur(0px)",
              duration: 1.2,
              ease: "power3.out",
              scrollTrigger: { trigger: section, start: "top 78%" },
            }
          );

          gsap.fromTo(items,
            { opacity: 0, y: 30 },
            {
              opacity: 1,
              y: 0,
              stagger: 0.08,
              duration: 0.9,
              ease: "power2.out",
              scrollTrigger: { trigger: section, start: "top 72%" },
            }
          );

          ScrollTrigger.create({
            trigger: section,
            start: "top center",
            end: "bottom center",
            onEnter: () => gsap.to(document.body, {
              backgroundColor: section.getAttribute("data-chapter-color") || "oklch(96% 0.02 245)",
              duration: 1.2,
              ease: "sine.inOut",
            }),
            onEnterBack: () => gsap.to(document.body, {
              backgroundColor: section.getAttribute("data-chapter-color") || "oklch(96% 0.02 245)",
              duration: 1.2,
              ease: "sine.inOut",
            }),
          });
        });

        const canvas = document.getElementById("painted-bg");
        if (!canvas) return;

        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        const scene = new THREE.Scene();
        const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 10);
        camera.position.z = 1;

        const uniforms = {
          uTime: { value: 0 },
          uMouse: { value: new THREE.Vector2(0.5, 0.5) },
          uResolution: { value: new THREE.Vector2(window.innerWidth, window.innerHeight) },
        };

        const material = new THREE.ShaderMaterial({
          transparent: true,
          uniforms,
          vertexShader: "void main(){gl_Position=vec4(position,1.0);}",
          fragmentShader: `
            uniform float uTime;
            uniform vec2 uMouse;
            uniform vec2 uResolution;
            void main(){
              vec2 uv=gl_FragCoord.xy/uResolution;
              float d=distance(uv,uMouse);
              float wave=sin((uv.x+uv.y+uTime*0.08)*22.0)*0.04;
              float bloom=smoothstep(0.45,0.0,d);
              vec3 a=vec3(0.95,0.90,0.84);
              vec3 b=vec3(0.89,0.80,0.94);
              vec3 c=vec3(0.66,0.79,0.96);
              vec3 col=mix(a,b,uv.y+wave);
              col=mix(col,c,bloom*0.55);
              gl_FragColor=vec4(col,0.20);
            }
          `,
        });

        const mesh = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), material);
        scene.add(mesh);

        const setSize = () => {
          uniforms.uResolution.value.set(window.innerWidth, window.innerHeight);
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
          renderer.setSize(window.innerWidth, window.innerHeight);
        };

        setSize();
        window.addEventListener("resize", setSize);
        window.addEventListener("pointermove", (event) => {
          uniforms.uMouse.value.set(
            event.clientX / window.innerWidth,
            1 - event.clientY / window.innerHeight,
          );
        });

        const render = (time: number) => {
          uniforms.uTime.value = time * 0.001;
          renderer.render(scene, camera);
          requestAnimationFrame(render);
        };

        requestAnimationFrame(render);
      });
    }
  </script>
</Layout>
