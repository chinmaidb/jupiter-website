{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@utils/*": ["src/utils/*"]
    },
    // Enable Node-style module resolution for modern TS/Node compatibility
    "moduleResolution": "bundler",
    "module": "esnext",
    // Essential for Astro's JSX handling
    "jsx": "preserve",
    "jsxImportSource": "astro",
    "allowJs": true,
    "target": "esnext",
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ]
  },
  "include": [
    ".",
    ".astro/types.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.astro"
  ],
  "exclude": ["node_modules", "dist"]
}
